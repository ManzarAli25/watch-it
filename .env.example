# --- VLM backend (OpenAI-compatible vision endpoint) ---
# Point at any OpenAI-compatible /chat/completions server:
#   local vLLM serving Qwen2.5-VL, Alibaba DashScope compat mode, OpenRouter, etc.
WATCH_VLM_BASE_URL=http://localhost:8000/v1
WATCH_VLM_MODEL=qwen/qwen3-vl-32b-instruct
# Full mode (native video) model. Leave empty to reuse WATCH_VLM_MODEL.
WATCH_FULL_MODEL=qwen/qwen3.6-flash
WATCH_VLM_API_KEY=
WATCH_VLM_MAX_TOKENS=4096

# Set WATCH_VLM_MODEL=stub to run with a deterministic fake provider (no key, no network).
# mode="full" (native video) needs a VIDEO-capable model: on OpenRouter use e.g.
# qwen/qwen3.5-* , qwen/qwen3.6-* , or xiaomi/mimo-v2.5 (qwen2.5-vl/qwen3-vl are image-only).

# --- Sampling / cost controls ---
WATCH_MAX_FRAMES=32
WATCH_FRAME_MAX_EDGE=768
WATCH_SCENE_THRESHOLD=27.0
WATCH_FALLBACK_INTERVAL=5.0
# Reject videos longer than this many seconds (0 disables). Default 30 min.
WATCH_MAX_DURATION=1800

# --- get_frames (Claude's own eyes) ---
# Hard cap on frames returned per get_frames call (protects the agent's context).
WATCH_GET_FRAMES_MAX=8

# --- Video cache (backs video_id / get_frames) ---
# Evict cached videos older than this many seconds (0 disables). Default 1 hour.
WATCH_CACHE_TTL=3600
# Hard size cap for copied downloads before LRU eviction (bytes). Default 2 GiB.
WATCH_CACHE_MAX_BYTES=2147483648

# --- Misc ---
# Leave empty to use the OS temp dir.
WATCH_TEMP_DIR=
# Phase 2 hook; no effect yet.
WATCH_OCR=0
